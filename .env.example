# Postgres connection for the READ-ONLY `metrics_app` login user (a member of
# the `metrics_reader` role created by fmly-chores migration 0052). Use the
# Supabase pooler connection string; never the service-role key or the
# postgres superuser.
DATABASE_URL=

# Optional: PEM text of the CA that signed the database certificate (Supabase
# dashboard -> Database -> SSL). Set it so the connection is verified; without
# it the connection is encrypted but the server isn't authenticated.
DATABASE_CA=

# Sign-in token for this dashboard (>= 32 chars, long and random):
#   openssl rand -base64 32
# Unset or too short => every page returns 404.
ADMIN_TOKEN=
